      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharp-API-Project.Application\CSharpAPIProject.Application.csproj" />
    <ProjectReference Include="..\CSharp-API-Project.Infrastructure\CSharpAPIProject.Infrastructure.csproj" />
  </ItemGroup>

</Project>
